{
  "name": "alexa-addon-simulator",
  "version": "0.1.0",
  "description": "Try your MCP server the way Alexa+ on an Echo Show would use it: MCP Apps cards on an Echo Show screen, elicitation, tasks, voice, and a readiness report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "alexa-addon-simulator": "server/start.mjs"
  },
  "files": [
    "dist",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/start.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "0.1.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
